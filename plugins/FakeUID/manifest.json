    {
      "id": "cabbird.scheduler",
      "minVersion": 1
    },
    {
      "id": "cabbird.localization",
      "minVersion": 1
    },
    {
      "id": "cabbird.interop.hook",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.unity.metadata",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.core",
      "minVersion": 1
    },
    {
      "id": "cabbird.profile",
      "minVersion": 1
    },
    {
      "id": "cabbird.json",
      "minVersion": 1
    },
    {
      "id": "cabbird.game-lifecycle",
      "minVersion": 1
    },
    {
      "id": "cabbird.window",
      "minVersion": 1
    }
