{
  "schemaVersion": 2,
  "id": "cabbird.unity-dump",
  "name": "IL2CPP Dump",
  "author": "Cabbird",
  "license": "AGPL-3.0-only",
  "version": "1.1.3",
  "audience": "developer",
  "description": "Export live IL2CPP fields, methods, properties, interfaces, plaintext metadata, and active resource/Lua catalogs on demand.",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "ap"
  ],
  "builds": [
    "ap-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "cabbird.core",
      "minVersion": 1
    },
    {
      "id": "cabbird.ui",
      "minVersion": 1
    },
    {
      "id": "cabbird.unity.dump",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.localization",
      "minVersion": 1
    },
    {
      "id": "cabbird.config",
      "minVersion": 1
    },
    {
      "id": "cabbird.scheduler",
      "minVersion": 1
    },
    {
      "id": "cabbird.window",
      "minVersion": 1
    },
    {
      "id": "cabbird.unity.il2cpp",
      "minVersion": 1
    },
    {
      "id": "cabbird.unity.metadata",
      "minVersion": 1
    },
    {
      "id": "cabbird.game-lifecycle",
      "minVersion": 1
    }
  ],
  "capabilities": [
    "ui",
    "unity-dump",
    "configuration",
    "scheduler",
    "ui-window",
    "unity-il2cpp",
    "unity-metadata"
  ]
}
