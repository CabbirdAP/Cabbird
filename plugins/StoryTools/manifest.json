      "minVersion": 1
    },
    {
      "id": "cabbird.game-lifecycle",
      "minVersion": 1
    },
    {
      "id": "cabbird.interop.hook",
      "minVersion": 1
    },
    {
      "id": "cabbird.localization",
      "minVersion": 1
    },
    {
      "id": "cabbird.profile",
      "minVersion": 1
    },
    {
      "id": "cabbird.json",
      "minVersion": 1
    },
    {
      "id": "cabbird.config",
      "minVersion": 1
    },
    {
      "id": "cabbird.scheduler",
      "minVersion": 1
    }
  ],
  "capabilities": [
    "ui",
    "ui-window",
    "unity-metadata",
