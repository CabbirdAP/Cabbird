{
  "schemaVersion": 2,
  "id": "cabbird.player-coords",
  "name": "Player Coordinates",
  "author": "Cabbird",
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "description": "Displays the controlled player world position from Game-domain snapshots. Refresh settings and the host-managed window persist across restarts.",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "ap"
  ],
  "builds": [
    "ap-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "cabbird.ui",
      "minVersion": 1
    },
    {
      "id": "cabbird.unity.player",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.localization",
      "minVersion": 1
    },
    {
      "id": "cabbird.config",
      "minVersion": 1
    },
    {
      "id": "cabbird.scheduler",
      "minVersion": 1
    },
    {
      "id": "cabbird.window",
      "minVersion": 1
    },
    {
      "id": "cabbird.core",
      "minVersion": 1,
      "optional": true
    }
  ],
  "capabilities": [
    "ui",
    "unity-player-snapshot",
    "configuration",
    "scheduler",
    "ui-window"
  ]
}
