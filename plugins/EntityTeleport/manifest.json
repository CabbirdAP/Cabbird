{
  "schemaVersion": 2,
  "id": "cabbird.entity-teleport",
  "name": "Entity Teleport",
  "author": "Cabbird",
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "description": "Move validated entity identities to world coordinates, relative offsets or the current player, with later position verification. Filters, targets, list and window settings persist across restarts.",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "ap"
  ],
  "builds": [
    "ap-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "cabbird.ui",
      "minVersion": 1
    },
    {
      "id": "cabbird.unity.entities",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.unity.transform",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.unity.player",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.config",
      "minVersion": 1
    },
    {
      "id": "cabbird.scheduler",
      "minVersion": 1
    },
    {
      "id": "cabbird.localization",
      "minVersion": 1
    },
    {
      "id": "cabbird.core",
      "minVersion": 1
    },
    {
      "id": "cabbird.unity.il2cpp",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.unity.metadata",
      "minVersion": 1,
      "optional": true
    }
  ],
  "capabilities": [
    "ui",
    "unity-entities",
    "unity-transform",
    "unity-player-snapshot",
    "configuration",
    "scheduler",
    "unity-il2cpp",
    "unity-metadata"
  ]
}
