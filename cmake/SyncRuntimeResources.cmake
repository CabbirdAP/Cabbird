cmake_minimum_required(VERSION 3.22)

# Synchronize published runtime data without replacing user configuration.
if(NOT CABBIRD_SOURCE_ROOT OR NOT CABBIRD_RUNTIME_ROOT OR NOT CABBIRD_RESOURCE_INVENTORY)
    message(FATAL_ERROR "Runtime resource synchronization requires source, destination and inventory paths")
endif()
file(REAL_PATH "${CABBIRD_RUNTIME_ROOT}" cabbird_runtime_root)

function(cabbird_runtime_resource_target relative result)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid runtime resource: ${relative}")
    endif()
    file(REAL_PATH "${cabbird_runtime_root}/${relative}" resolved)
    cmake_path(IS_PREFIX cabbird_runtime_root "${resolved}" NORMALIZE inside_runtime)
    if(NOT inside_runtime OR resolved STREQUAL cabbird_runtime_root)
        message(FATAL_ERROR "Runtime resource escapes its destination: ${relative}")
    endif()
    set(${result} "${resolved}" PARENT_SCOPE)
endfunction()

set(cabbird_current_resources)
foreach(cabbird_directory IN ITEMS locales/host assets/fonts assets/images profiles)
    file(REAL_PATH "${CABBIRD_SOURCE_ROOT}/${cabbird_directory}" cabbird_source_directory)
    file(REAL_PATH "${cabbird_runtime_root}/${cabbird_directory}" cabbird_destination_directory)
    cmake_path(IS_PREFIX cabbird_source_directory "${cabbird_destination_directory}" NORMALIZE destination_in_source)
    cmake_path(IS_PREFIX cabbird_destination_directory "${cabbird_source_directory}" NORMALIZE source_in_destination)
    if(destination_in_source OR source_in_destination)
        message(FATAL_ERROR "Runtime source and destination resources overlap: ${cabbird_directory}")
    endif()
    file(GLOB_RECURSE cabbird_files LIST_DIRECTORIES FALSE RELATIVE "${CABBIRD_SOURCE_ROOT}"
        "${CABBIRD_SOURCE_ROOT}/${cabbird_directory}/*")
    list(APPEND cabbird_current_resources ${cabbird_files})
endforeach()
if(EXISTS "${CABBIRD_SOURCE_ROOT}/config/CONTACT")
    list(APPEND cabbird_current_resources CONTACT)
endif()
list(SORT cabbird_current_resources)

set(cabbird_previous_resources)
if(EXISTS "${CABBIRD_RESOURCE_INVENTORY}")
    file(STRINGS "${CABBIRD_RESOURCE_INVENTORY}" cabbird_previous_resources)
endif()
# Validate every managed path before creating directories or writing defaults.
foreach(cabbird_relative IN LISTS cabbird_previous_resources cabbird_current_resources)
    if(NOT cabbird_relative MATCHES "^(CONTACT|locales/host/.+|assets/(fonts|images)/.+|profiles/.+)$")
        message(FATAL_ERROR "Invalid managed runtime resource: ${cabbird_relative}")
    endif()
    cabbird_runtime_resource_target("${cabbird_relative}" cabbird_destination)
endforeach()

set(cabbird_default_resources cabbird.ini plugin-repositories.json)
file(GLOB cabbird_theme_defaults RELATIVE "${CABBIRD_SOURCE_ROOT}"
    "${CABBIRD_SOURCE_ROOT}/config/themes/*.json")
list(APPEND cabbird_default_resources ${cabbird_theme_defaults})
foreach(cabbird_default IN LISTS cabbird_default_resources)
    set(cabbird_destination "${cabbird_runtime_root}/${cabbird_default}")
    if(NOT EXISTS "${cabbird_destination}" AND NOT IS_SYMLINK "${cabbird_destination}")
        cabbird_runtime_resource_target("${cabbird_default}" cabbird_destination)
    endif()
endforeach()

file(MAKE_DIRECTORY "${cabbird_runtime_root}")
foreach(cabbird_default IN LISTS cabbird_default_resources)
    set(cabbird_destination "${cabbird_runtime_root}/${cabbird_default}")
    if(NOT EXISTS "${cabbird_destination}" AND NOT IS_SYMLINK "${cabbird_destination}")
        if(cabbird_default MATCHES "^config/themes/")
            set(cabbird_source "${CABBIRD_SOURCE_ROOT}/${cabbird_default}")
        else()
            set(cabbird_source "${CABBIRD_SOURCE_ROOT}/config/${cabbird_default}")
        endif()
        get_filename_component(cabbird_parent "${cabbird_destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${cabbird_parent}")
        file(COPY_FILE "${cabbird_source}" "${cabbird_destination}")
    endif()
endforeach()
foreach(cabbird_relative IN LISTS cabbird_previous_resources)
    if(NOT cabbird_relative IN_LIST cabbird_current_resources)
        cabbird_runtime_resource_target("${cabbird_relative}" cabbird_destination)
        file(REMOVE "${cabbird_destination}")
    endif()
endforeach()
foreach(cabbird_relative IN LISTS cabbird_current_resources)
    cabbird_runtime_resource_target("${cabbird_relative}" cabbird_destination)
    get_filename_component(cabbird_parent "${cabbird_destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${cabbird_parent}")
    if(cabbird_relative STREQUAL "CONTACT")
        set(cabbird_source "${CABBIRD_SOURCE_ROOT}/config/CONTACT")
    else()
        set(cabbird_source "${CABBIRD_SOURCE_ROOT}/${cabbird_relative}")
    endif()
    file(COPY_FILE "${cabbird_source}" "${cabbird_destination}" ONLY_IF_DIFFERENT)
endforeach()
if(NOT EXISTS "${CABBIRD_RESOURCE_INVENTORY}" OR
   NOT cabbird_previous_resources STREQUAL cabbird_current_resources)
    get_filename_component(cabbird_inventory_directory "${CABBIRD_RESOURCE_INVENTORY}" DIRECTORY)
    file(MAKE_DIRECTORY "${cabbird_inventory_directory}")
    string(REPLACE ";" "\n" cabbird_inventory "${cabbird_current_resources}")
    file(WRITE "${CABBIRD_RESOURCE_INVENTORY}" "${cabbird_inventory}\n")
endif()
